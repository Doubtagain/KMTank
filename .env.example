# Copy to .env for local development. Every value here has a working default
# except JWT_SECRET in production and GOOGLE_CLIENT_ID for ranked play.

# --- server ---------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Browser origins allowed to call the API and open a websocket.
# Use the exact origin(s) your client is served from in production, e.g.
#   CORS_ORIGINS=https://kmtank.pages.dev,https://kmtank.example.com
CORS_ORIGINS=*

# Signs KMTank session tokens. Generate with:  openssl rand -base64 48
# Rotating this signs every player out.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_TTL_SECONDS=2592000

# --- Google sign-in -------------------------------------------------------
# OAuth 2.0 Client ID (type: Web application) from Google Cloud Console.
# Add your client origin to "Authorised JavaScript origins".
# Leave empty to run casual-only with no sign-in.
GOOGLE_CLIENT_ID=

# --- database -------------------------------------------------------------
# Postgres connection string. Neon and Supabase both have a free tier.
# When empty the server uses an in-memory store and ranks reset on restart.
DATABASE_URL=
DATABASE_SSL=true

# --- gameplay -------------------------------------------------------------
BOTS_ENABLED=true
BOT_TARGET=8
RANKED_MATCH_SECONDS=480
RANKED_QUEUE_GRACE=30
SEASON=1

# Enables POST /api/auth/dev, which mints a session without Google so ranked
# can be tested locally. Ignored entirely when NODE_ENV=production.
ALLOW_DEV_LOGIN=0

# --- client (build time) --------------------------------------------------
# Origin of the deployed game server. Set this on the static host.
VITE_SERVER_URL=http://localhost:8080
